# 复制为 .env 后填写。端口/数据目录等非敏感项有默认值，API Key 必须自行配置。
# 环境变量优先级高于界面设置（FR-707）。

# ---- 模型接口 ----
# 下面几项**默认留空**，由设置页决定（在那里可以随时切换、改完立即生效）。
# 一旦在这里设了值，就会覆盖设置页里的同名项——设置页会提示"由环境变量决定"。
#
# 接口类型：
#   deepseek = 额外启用思考开关、缓存命中统计、余额查询与空闲时段半价（默认）
#   openai   = 只发标准字段，任何 /v1/chat/completions 服务都能接
# 换接口时通常要同时改地址与模型名，例如本地 Ollama：
#   WELEARN_PROVIDER=openai
#   WELEARN_BASE_URL=http://127.0.0.1:11434/v1
#   WELEARN_MODEL_DEFAULT=qwen2.5:7b
#   WELEARN_MODEL_PRO=qwen2.5:7b
# WELEARN_PROVIDER=deepseek
# WELEARN_BASE_URL=https://api.deepseek.com
# WELEARN_MODEL_DEFAULT=deepseek-flash
# WELEARN_MODEL_PRO=deepseek-v4-pro

# ---- API Key ----
# 也可以只在设置页里填；这里设了就以这里为准（环境变量优先，FR-707）
WELEARN_API_KEY=

# ---- 数据与密钥 ----
# SQLite 与日志的根目录；留空则使用项目内 ./data（D3 建议指向项目外目录）
WELEARN_DATA_DIR=./data
# API Key 静态加密密钥（Fernet，44 字符 urlsafe base64）。
# 留空则自动在数据目录生成 secret.key（权限 0600）。生产环境建议显式提供。
WELEARN_SECRET_KEY=

# ---- 服务 ----
WELEARN_HOST=127.0.0.1
WELEARN_PORT=8000
# 日志级别同样由设置页控制；在这里设了会覆盖设置页（设置页会提示）
# WELEARN_LOG_LEVEL=INFO
# 完整 LLM 请求/响应审计日志（FR-715）。默认由设置页的 audit_enabled 控制；
# 这里设为 true 可强制开启（与设置项**取或**），用于设置读不出来时仍能抓到一次现场。
WELEARN_LOG_LLM_PAYLOAD=false
